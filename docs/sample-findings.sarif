{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CLOUDRANGE",
          "version": "1.0.0",
          "informationUri": "https://github.com/VISHNU0906/cloudrange",
          "rules": [
            {
              "id": "CR-IAM-PRIVESC",
              "name": "IamPrivilegeEscalationPath",
              "shortDescription": {
                "text": "Principal can escalate to administrator access."
              },
              "fullDescription": {
                "text": "The principal holds a permission (or chain of permissions) that allows it to obtain administrator-equivalent access via a known IAM privilege-escalation technique."
              },
              "helpUri": "https://rhinosecuritylabs.com/aws/aws-privilege-escalation-methods-mitigation/",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-IAM-CREATEKEY",
              "name": "OverpermissiveCreateAccessKey",
              "shortDescription": {
                "text": "iam:CreateAccessKey allowed on other users."
              },
              "fullDescription": {
                "text": "A principal can create access keys for IAM users other than itself, letting it impersonate them."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-IAM-PASSROLE",
              "name": "PassRoleToCompute",
              "shortDescription": {
                "text": "iam:PassRole with compute create/invoke."
              },
              "fullDescription": {
                "text": "A principal can pass an over-privileged role to a compute service (Lambda/EC2) and execute code with that role's permissions."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-IAM-SELFPOLICY",
              "name": "SelfPolicyModification",
              "shortDescription": {
                "text": "Principal can modify its own (or others') IAM policy."
              },
              "fullDescription": {
                "text": "iam:PutUserPolicy / iam:AttachUserPolicy allow a principal to grant itself administrator access."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-IAM-ADMINROLE",
              "name": "OverPrivilegedRole",
              "shortDescription": {
                "text": "Role holds AdministratorAccess."
              },
              "fullDescription": {
                "text": "A service or instance role is granted administrator access, creating a large blast radius if the role is assumed or its compute is compromised."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-IAM-TRUST",
              "name": "OverBroadAssumeRoleTrust",
              "shortDescription": {
                "text": "Role trust policy is over-broad."
              },
              "fullDescription": {
                "text": "A role trusts another principal/account-root, enabling lateral movement via sts:AssumeRole."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CR-S3-PUBLIC",
              "name": "PublicS3Bucket",
              "shortDescription": {
                "text": "S3 bucket is publicly accessible."
              },
              "fullDescription": {
                "text": "Block Public Access is disabled or an ACL/policy grants public access."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-S3-NOENC",
              "name": "S3BucketUnencrypted",
              "shortDescription": {
                "text": "S3 bucket has no default encryption."
              },
              "fullDescription": {
                "text": "Default server-side encryption is not enabled on the bucket."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CR-EC2-IMDSV1",
              "name": "Imdsv1Enabled",
              "shortDescription": {
                "text": "EC2 instance allows token-less IMDSv1."
              },
              "fullDescription": {
                "text": "IMDSv1 lets an SSRF or on-host attacker read the instance role's credentials without a session token."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-EC2-SECRETS",
              "name": "SecretsInUserData",
              "shortDescription": {
                "text": "Secrets baked into EC2 user-data."
              },
              "fullDescription": {
                "text": "Plaintext credentials/tokens in user-data are readable by anyone who can describe the instance or reach the metadata service."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR-LAMBDA-ADMIN",
              "name": "OverPrivilegedLambda",
              "shortDescription": {
                "text": "Lambda function uses an admin execution role."
              },
              "fullDescription": {
                "text": "A function runs with an administrator-equivalent execution role."
              },
              "helpUri": "https://github.com/VISHNU0906/cloudrange",
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": [
